{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "app.py",
        "db.py",
        "catalog.py",
        "templates/**",
        "static/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/api/index.py" },
    { "source": "/favicon.ico", "destination": "/static/img/favicon.svg" },
    { "source": "/(.*)", "destination": "/api/index.py" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
